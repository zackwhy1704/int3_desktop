{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Company Brain",
  "version": "0.1.0",
  "identifier": "com.companybrain.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Company Brain",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8642 ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "externalBin": [
      "binaries/hermes"
    ],
    "resources": {
      "agent/hermes_config.json": "resources/hermes_config.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.1.0.0"
      },
      "nsis": {
        "installMode": "perUser",
        "allowWebviewInstall": true
      }
    },
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "__TAURI_UPDATE_PUBKEY__",
      "endpoints": [
        "__GATEWAY_URL__/desktop/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
