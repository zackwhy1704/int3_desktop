# Gate 4: Google OIDC client ID (required for sign-in).
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Type: "Desktop application". Copy the Client ID here.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Optional: override backend / gateway URLs (default to production endpoints).
# INT3_BACKEND_URL=https://api.int3.ai
# INT3_GATEWAY_URL=https://gw.int3.ai
# INT3_MCP_SERVER_PATH=agent/mcp/server.js
