{
  "_doc": [
    "Pre-baked Hermes gateway configuration.",
    "Placeholders (__GATEWAY_URL__, __USER_OIDC_TOKEN__) are replaced at runtime.",
    "Gate 4: Tauri writes the resolved config to the app data directory with",
    "the real OIDC token before spawning the sidecar. This file is the template.",
    "",
    "Hermes docs: https://hermes-agent.nousresearch.com/docs/developer-guide/programmatic-integration"
  ],
  "gateway": {
    "host": "127.0.0.1",
    "port": 8642,
    "auth": {
      "type": "bearer",
      "token": "__HERMES_LOCAL_TOKEN__"
    }
  },
  "llm": {
    "base_url": "__GATEWAY_URL__/v1",
    "model": "claude-sonnet-4-6",
    "auth": {
      "type": "bearer",
      "token": "__USER_OIDC_TOKEN__"
    }
  },
  "mcp_servers": [
    {
      "name": "brain",
      "transport": "stdio",
      "command": "node",
      "args": ["agent/mcp/server.js"],
      "env": {
        "BRAIN_PROVIDER": "remote",
        "BRAIN_API_URL": "__BACKEND_URL__",
        "BRAIN_AUTH_TOKEN": "__USER_OIDC_TOKEN__"
      }
    }
  ]
}
